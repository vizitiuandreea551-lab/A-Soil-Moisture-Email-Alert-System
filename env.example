# Copy to .env and fill in your private details. Never share .env.
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your_replacement_google_app_password
RECIPIENT_EMAIL=recipient-email@gmail.com
SENSOR_PIN=17
# Existing code assumes 1 means dry; set to 0 if your sensor reads opposite.
DRY_SENSOR_VALUE=1
POLL_INTERVAL=2
WEB_PORT=5000
